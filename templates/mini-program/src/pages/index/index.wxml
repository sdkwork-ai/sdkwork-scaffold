<view class="page">
  <view class="eyebrow">SDKWORK APPLICATION FOUNDATION</view>
  <view class="title">{{appName}}</view>
  <view class="lede">WeChat mini-program surface initialized with SDKWork component composition.</view>

  <view class="section-title">Integrated components</view>
  <view wx:if="{{components.length === 0}}" class="empty">No common component is enabled for this application.</view>
  <view wx:for="{{components}}" wx:key="id" class="card">
    <view class="card-title">{{item.title}}</view>
    <view class="card-detail">{{item.supported ? item.sdkPackage : item.reason}}</view>
    <view class="card-state {{item.supported ? 'ready' : 'planned'}}">{{item.supported ? 'Linked' : 'Plan'}}</view>
  </view>

  <view class="footer">{{appCode}}</view>
</view>
